# Container image
DATACASK_IMAGE=registry.cn-guangzhou.aliyuncs.com/zhisuaninfo/datacask:latest
DATACASK_HTTP_PORT=2226

# Application
APP_NAME=Datacask
APP_ENV=production
APP_DEBUG=false
APP_URL=https://backup.example.com
APP_KEY=base64:replace-with-a-generated-key
APP_DISPLAY_TIMEZONE=Asia/Shanghai
TRUSTED_PROXIES=127.0.0.0/8,172.16.0.0/12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Application metadata database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=datacask
DB_USERNAME=datacask
DB_PASSWORD=replace-with-a-strong-password

# Queue workers
QUEUE_CONNECTION=database
BACKUP_JOB_TIMEOUT_SECONDS=10800
